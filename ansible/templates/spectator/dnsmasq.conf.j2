# spectator: 只在 eth0 上做 DHCP，不做 DNS，不做 PXE
interface=eth0
except-interface=wlan0
port=0
domain=pi
no-hosts

# 未登记设备的动态地址
dhcp-range=10.0.0.2,10.0.0.99,1h

# eye 按主机名拿固定地址
dhcp-host=eye01,10.0.0.101
dhcp-host=eye02,10.0.0.102
dhcp-host=eye03,10.0.0.103
dhcp-host=eye04,10.0.0.104
dhcp-host=eye05,10.0.0.105
dhcp-host=eye06,10.0.0.106
dhcp-host=eye07,10.0.0.107
dhcp-host=eye08,10.0.0.108
dhcp-host=eye09,10.0.0.109
dhcp-host=eye10,10.0.0.110
dhcp-host=eye11,10.0.0.111
dhcp-host=eye12,10.0.0.112

log-dhcp
